{
  "expo": {
    "name": "orcamento-de-servicos",
    "slug": "orcamento-de-servicos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arthurrios.orcamento-de-servicos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arthurrios.orcamentodeservicos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para anexar imagens às vistorias.",
          "cameraPermission": "Permita o acesso à câmera para fotografar a vistoria."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para fotografar a vistoria.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-background-task",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita o acesso ao microfone para gravar e transcrever a vistoria por voz."
        }
      ],
      "./plugins/withWhisperKit"
    ],
    "extra": {
      "eas": {
        "projectId": "9ba06b21-f94d-4edd-9da1-f8ca1c6d2b17"
      }
    },
    "owner": "alyson.vilela"
  }
}
