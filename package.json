{
	"name": "orcamento-de-servicos",
	"version": "1.0.0",
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint App.tsx src convex/*.ts",
		"format": "biome format --write App.tsx src convex/*.ts",
		"generate-icons": "node scripts/generate-icons-adapted.js",
		"convex:seed": "convex dev --once --run seed:run",
		"convex:migrate": "convex dev --once --run migrations:backfillChecklistItemIds",
		"convex:resync-applications": "convex dev --once --run migrations:resyncApplicationItemsFromChecklist"
	},
	"dependencies": {
		"@expo-google-fonts/lato": "^0.4.1",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@hookform/resolvers": "^5.9.1",
		"@legendapp/list": "^3.3.11",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/datetimepicker": "9.1.0",
		"@react-navigation/bottom-tabs": "^7",
		"@react-navigation/elements": "^2.7.0",
		"@react-navigation/native": "^7.3.18",
		"@react-navigation/native-stack": "^7.5.1",
		"convex": "^1.45.0",
		"convex-helpers": "^0.1.124",
		"expo": "^57.0.17",
		"expo-audio": "~57.0.5",
		"expo-background-task": "~57.0.18",
		"expo-camera": "~57.0.5",
		"expo-constants": "^57.0.18",
		"expo-file-system": "^57.0.7",
		"expo-font": "~57.0.4",
		"expo-haptics": "~57.0.3",
		"expo-image": "^57.0.5",
		"expo-image-manipulator": "~57.0.18",
		"expo-image-picker": "^57.0.17",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"expo-task-manager": "~57.0.18",
		"moti": "^0.30.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.88.0",
		"react-native": "0.86.3",
		"react-native-currency-input": "^1.1.1",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-reanimated": "4.5.1",
		"react-native-reorderable-list": "^0.18.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-svg": "15.15.4",
		"react-native-web": "^0.21.0",
		"react-native-worklets": "0.10.1",
		"uuid": "^13.0.0",
		"whisper-kit-expo": "^1.1.6",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@arthurrios/biome-config": "^1.1.4",
		"@biomejs/biome": "^2.2.7",
		"@svgr/cli": "^8.1.0",
		"@types/react": "~19.2.4",
		"typescript": "~6.0.3"
	},
	"private": true
}
